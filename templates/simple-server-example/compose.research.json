				"NODE_ENV": "production",
				"HOST": "0.0.0.0",
				"PROVIDER": "openai",
				"RESEARCH_WORKER_SECRET_FILE": "/run/secrets/openai-worker-token",
				"OPENAI_API_KEY_FILE": "/run/secrets/openai-api-key",
				"RESEARCH_EGRESS_PROXY": "http://egress-openai:3128"
			},
			"secrets": ["openai-worker-token", "openai-api-key"],
			"networks": ["openai"],
			"depends_on": ["egress-openai"],
			"healthcheck": {
				"test": [
