{
	"name": "tldraw-research",
	"services": {
		"api": {
			"user": "10001:10001",
			"read_only": true,
			"cap_drop": ["ALL"],
			"security_opt": ["no-new-privileges:true"],
			"init": true,
			"pids_limit": 64,
			"cpus": 1,
			"mem_limit": "512m",
			"memswap_limit": "512m",
			"tmpfs": ["/tmp:rw,noexec,nosuid,nodev,size=16m,uid=10001,gid=10001,mode=0700"],
			"restart": "unless-stopped",
			"ulimits": {
				"nofile": {
					"soft": 1024,
					"hard": 1024
				}
			},
			"logging": {
				"driver": "local",
				"options": {
					"max-size": "5m",
					"max-file": "2"
				}
			},
			"build": {
				"context": "../..",
				"dockerfile": "templates/simple-server-example/deploy/research/Dockerfile",
				"target": "api"
			},
			"environment": {
				"NODE_ENV": "production",
				"HOST": "0.0.0.0",
				"BRAINSTORM_DATA_DIR": "/data/metadata",
				"RESEARCH_WORKER_URLS": "{\"openai\": \"http://research-openai:5860\", \"gemini\": \"http://research-gemini:5860\", \"mistral\": \"http://research-mistral:5860\", \"web\": \"http://research-web:5860\"}",
				"RESEARCH_OPENAI_SECRET_FILE": "/run/secrets/openai-worker-token",
				"RESEARCH_GEMINI_SECRET_FILE": "/run/secrets/gemini-worker-token",
				"RESEARCH_MISTRAL_SECRET_FILE": "/run/secrets/mistral-worker-token",
				"RESEARCH_WEB_SECRET_FILE": "/run/secrets/web-worker-token",
				"BRAINSTORM_TRUSTED_CLIENT_IP": "172.31.240.2"
			},
			"volumes": ["board-data:/data"],
			"networks": {
				"openai": {},
				"gemini": {},
				"mistral": {},
				"web": {},
				"ingress": {
					"ipv4_address": "172.31.240.3"
				}
			},
			"secrets": [
				"openai-worker-token",
				"gemini-worker-token",
				"mistral-worker-token",
				"web-worker-token"
			],
			"dns": ["127.0.0.1"],
			"dns_opt": ["timeout:1", "attempts:1"],
			"healthcheck": {
				"test": [
					"CMD",
					"node",
					"-e",
					"fetch('http://127.0.0.1:5858/api/brainstorm/me').then(r=>{if(r.status!==403)process.exit(1)}).catch(()=>process.exit(1))"
				],
				"interval": "5s",
				"timeout": "3s",
				"retries": 10,
				"start_period": "5s"
			}
		},
		"research-openai": {
			"user": "10001:10001",
			"read_only": true,
