			},
			"networks": ["openai", "openai-egress"],
			"volumes": ["./deploy/research/openai.squid.conf:/etc/squid/squid.conf:ro"],
			"healthcheck": {
				"test": ["CMD", "bash", "-ec", "exec 3<>/dev/tcp/127.0.0.1/3128"],
				"interval": "5s",
				"timeout": "3s",
				"retries": 10,
				"start_period": "5s"
			}
		},
